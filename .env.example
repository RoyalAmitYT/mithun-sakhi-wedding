# ==============================================================================
# Mithun & Sakhi Wedding Website — Environment Configuration Template
# ==============================================================================
# Copy this file to .env.local for local overrides.
# DO NOT COMMIT REAL SECRETS TO VERSION CONTROL.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PUBLIC CLIENT-SIDE CONFIGURATION (Exposed to the browser via NEXT_PUBLIC_*)
# ------------------------------------------------------------------------------
# Primary site deployment URL (used for canonical URLs, metadata, and Open Graph previews)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Public Supabase API configuration (local or production)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_placeholder
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ------------------------------------------------------------------------------
# 2. SERVER-ONLY SECRETS (Never exposed to the browser or client components)
# ------------------------------------------------------------------------------
# Supabase administrative service role key (restricted strictly to server-side tasks)
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-placeholder
