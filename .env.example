# ==============================================================================
# Mithun & Sakhi Wedding Website — Environment Configuration Template
# ==============================================================================
# Copy this file to .env.local for local overrides.
# DO NOT COMMIT REAL SECRETS TO VERSION CONTROL.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PUBLIC CLIENT-SIDE CONFIGURATION (Exposed to the browser via NEXT_PUBLIC_*)
# ------------------------------------------------------------------------------
# Primary site deployment URL (used for canonical URLs, metadata, and Open Graph previews)
# Production: https://mithun-sakhi-wedding.vercel.app
# Preview:    https://<branch>-mithun-sakhi-wedding.vercel.app (or automatically derived by Vercel)
# Local:      http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Public Supabase API configuration (Mumbai ap-south-1)
NEXT_PUBLIC_SUPABASE_URL=https://wsfbvpvymwjyzxllxpvj.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_placeholder
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ------------------------------------------------------------------------------
# 2. SERVER-ONLY SECRETS (Never exposed to the browser or client components)
# ------------------------------------------------------------------------------
# Supabase administrative service role key (restricted strictly to server-side tasks)
# Required for distributed atomic rate limiting RPC execution and backend storage management.
# Execution of check_rate_limit_atomic is restricted exclusively to service_role.
# SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-placeholder

# High-entropy cryptographic salt for HMAC-SHA256 IP pseudonymization
# REQUIRED in deployed environments (Preview & Production). Missing salt in deployed mode halts submissions.
# Preview & Production should use distinct 32-byte hex values.
# Generate using: openssl rand -hex 32
# RATE_LIMIT_SALT=your-random-rate-limit-salt-hex-32
